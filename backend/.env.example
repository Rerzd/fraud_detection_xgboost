# Backend configuration. Copy to backend/.env to override a value (that file is gitignored).
# Every variable is optional: the values below are the defaults.
# Real environment variables win over this file.

# Where the trained pipeline is read from. Default: backend/fraud_model.pkl
# FRAUD_MODEL_PATH=

# Label stored with every prediction and shown in /api/v1/health and /api/v1/model/info.
# The API also reports the first 12 characters of the model file's sha256 as `model_hash`.
FRAUD_MODEL_VERSION=xgb-paysim-v1

# SQLite file for the prediction history. Created on first start. Default: backend/data/fraud.db
# FRAUD_DB_PATH=

# Decision thresholds on the fraud probability, both in (0, 1) with review < fraud:
#   probability <  FRAUD_REVIEW_THRESHOLD                      -> low risk, approve
#   FRAUD_REVIEW_THRESHOLD <= probability < FRAUD_THRESHOLD    -> review, send to manual review
#   probability >= FRAUD_THRESHOLD                             -> high risk, flag for fraud
# 0.5 is the cut-off used in the training notebook's evaluation.
FRAUD_REVIEW_THRESHOLD=0.2
FRAUD_THRESHOLD=0.5

# Batch upload limits (POST /api/v1/predict/batch): data rows per file, and file size in bytes (5 MB).
FRAUD_BATCH_MAX_ROWS=10000
FRAUD_BATCH_MAX_BYTES=5242880

# Browser origins allowed to call the API, comma-separated.
FRAUD_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# One of DEBUG, INFO, WARNING, ERROR.
FRAUD_LOG_LEVEL=INFO
